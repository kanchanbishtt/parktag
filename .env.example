# Copy this file to .env and fill in real values. Never commit .env.
# This file must only contain placeholder values — no real secrets.

# ── Runtime ──────────────────────────────────────────────────────────────
APP_ENV=dev
PORT=3000
APP_BASE_URL=http://localhost:4000
# Optional override for the scan/activation domain used in printed-QR URLs.
# Empty by default (QR uses whatever host it was generated on).
SCAN_BASE_URL=
# Public WhatsApp support handle shown on the sticker activation wizard.
# Digits with country code, no "+" — e.g. 919999999999. Empty → card hidden.
SUPPORT_WHATSAPP_NUMBER=

# ── MongoDB ──────────────────────────────────────────────────────────────
# Full connection string, including credentials. Never hardcode this in code.
# REQUIRED in production — the server refuses to start without it.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority
MONGODB_DB_NAME=wavetag
# Optional prefix for collection names (e.g. "dev_" in non-production envs)
MONGODB_COLLECTION_PREFIX=dev_

# ── Exotel (voice / SMS) ─────────────────────────────────────────────────
EXOTEL_API_BASE_URL=https://api.in.exotel.com
EXOTEL_ACCOUNT_SID=changeme
EXOTEL_API_KEY=changeme
EXOTEL_API_TOKEN=changeme
EXOTEL_CALLER_ID=changeme
EXOTEL_STATUS_CALLBACK_URL=https://your-domain.example/api/webhooks/exotel/status
EXOTEL_SMS_SENDER_ID=changeme
EXOTEL_SMS_DLT_ENTITY_ID=changeme
EXOTEL_SMS_TEMPLATE_ID=changeme
# Shared secret Exotel has no native signing scheme for callbacks, so this
# is embedded as ?token=<secret> in both the status callback URL above and
# the dial-whom URL configured in the Exotel App Bazaar flow.
EXOTEL_WEBHOOK_SECRET=changeme
# Only used by the ad-hoc test.js smoke-test script
EXOTEL_TEST_FROM_NUMBER=+910000000000

# ── Meta WhatsApp Cloud API ──────────────────────────────────────────────
META_WHATSAPP_PHONE_NUMBER_ID=changeme
META_WHATSAPP_ACCESS_TOKEN=changeme
WHATSAPP_BUSINESS_ACCOUNT_ID=changeme
# Verification token you choose yourself for the Meta webhook handshake.
# No code-level default — if unset, webhook verification simply fails closed.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=changeme
# Meta App Secret (Settings → Basic in the Meta App dashboard, NOT the
# WhatsApp access token) — verifies the X-Hub-Signature-256 header on every
# inbound webhook POST. Without it, the webhook accepts unsigned requests.
META_APP_SECRET=changeme

# ── Email / SMTP ─────────────────────────────────────────────────────────
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=changeme
EMAIL_SMTP_PASS=changeme
EMAIL_FROM=noreply@parktag.me

# ── Google OAuth ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_CALLBACK_URL=http://127.0.0.1:4000/api/auth/google/callback

# ── Firebase (phone auth) ────────────────────────────────────────────────
# Firebase Web API keys are not secret by design (restrict via Firebase
# Console: API key restrictions + App Check), but still keep them in env
# vars rather than hardcoded so they can be rotated without a code change.
FIREBASE_API_KEY=changeme
FIREBASE_PROJECT_ID=changeme

# ── Razorpay ─────────────────────────────────────────────────────────────
# RAZORPAY_KEY_ID is safe to expose to the client (publishable key).
# RAZORPAY_KEY_SECRET must NEVER be sent to the client or logged.
# Both REQUIRED in production — the server refuses to start without them.
RAZORPAY_KEY_ID=changeme
RAZORPAY_KEY_SECRET=changeme

# ── Admin / internal bootstrap ───────────────────────────────────────────
SUPER_ADMIN_BOOTSTRAP_KEY=changeme

# ── Meta App Review reviewer account (routes/system/reviewer-setup.js) ───
# Remove the /api/system/reviewer-setup route entirely once App Review is
# approved. Until then, keep these unset in production unless a review is
# actively in progress, and rotate REVIEWER_SETUP_SECRET after each use.
REVIEWER_SETUP_EMAIL=reviewer@parktag.me
REVIEWER_SETUP_PASSWORD=changeme
REVIEWER_SETUP_MOBILE=+910000000099
REVIEWER_SETUP_SECRET=changeme

# ── Demo seed defense-in-depth (routes/system/demo.js) ────────────────────
# Optional. POST /api/demo/seed already refuses to register outside
# non-production, but this adds a required secret on top as a backstop.
DEMO_SEED_SECRET=changeme

# ── Delhivery (physical sticker fulfilment) ───────────────────────────────
# Optional — pincode checks and shipment booking are skipped entirely
# (fail-open) if DELHIVERY_API_KEY or DELHIVERY_PICKUP_LOCATION are unset.
DELHIVERY_API_KEY=changeme
# Only override if you have a separate staging/sandbox account — defaults to
# Delhivery's staging URL outside production, production URL in production.
# Note: not all accounts have staging access; if yours doesn't, staging calls
# will 401 and you'll need to set this to https://track.delhivery.com even in dev.
DELHIVERY_BASE_URL=
# Must exactly match (case-sensitive) a pickup location/warehouse already
# registered in the Delhivery dashboard — this app does not create it for you.
DELHIVERY_PICKUP_LOCATION=changeme
DELHIVERY_SELLER_GST_TIN=
DELHIVERY_HSN_CODE=

# ── Manual verification scripts (src/backend/scripts/verify-*.js) ────────
WAVETAG_VERIFY_BASE_URL=http://127.0.0.1:3000
WAVETAG_VERIFY_TOKEN=changeme
WAVETAG_VERIFY_SCANNER_PHONE=+910000000000
WAVETAG_VERIFY_MESSAGE=Hi, your vehicle is blocking my way. Please move it when possible.

# ── Landing traffic geography (admin → Traffic) ───────────────────────────
# Answers "where is our traffic coming from" from the visitor's IP, resolved
# server-side to a city and then discarded. No permission prompt, no cookie,
# and no IP or User-Agent is ever stored — see routes/system/analytics.js.
#
# REQUIRED to switch the feature on, and the SAME value must be set on the
# landing service too (landing/proxy.ts reads it). The landing site and this
# API are separate deployments, so the visitor's IP arrives in the request body
# rather than on the socket; this key is what makes that forwarded address
# trustworthy. Unset → every beacon is refused and the Traffic page stays empty.
ANALYTICS_INGEST_KEY=changeme
# Optional. Salt for the daily-rotating visitor digest; falls back to the
# ingest key above. Set it only if you'd rather the two not share a value.
ANALYTICS_HASH_SALT=
# Optional. The marketing site's own URL, so a link from our own pages is not
# counted as an inbound traffic source. e.g. https://parktag.me
LANDING_BASE_URL=
# Optional. IP→location provider: any URL containing {ip} that returns JSON
# with country / region / city. Defaults to ipwho.is, which needs no API key.
GEOIP_URL=
