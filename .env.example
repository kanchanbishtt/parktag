# Copy this file to .env and fill in real values. Never commit .env.
# This file must only contain placeholder values — no real secrets.

# ── Runtime ──────────────────────────────────────────────────────────────
APP_ENV=dev
PORT=3000
APP_BASE_URL=http://localhost:4000
# Optional override for the scan/activation domain used in printed-QR URLs.
# Empty by default (QR uses whatever host it was generated on).
SCAN_BASE_URL=
# Public WhatsApp support handle shown on the sticker activation wizard.
# Digits with country code, no "+" — e.g. 919999999999. Empty → card hidden.
SUPPORT_WHATSAPP_NUMBER=

# ── MongoDB ──────────────────────────────────────────────────────────────
# Full connection string, including credentials. Never hardcode this in code.
# REQUIRED in production — the server refuses to start without it.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority
MONGODB_DB_NAME=wavetag
# Optional prefix for collection names (e.g. "dev_" in non-production envs)
MONGODB_COLLECTION_PREFIX=dev_

# ── Exotel (voice) ───────────────────────────────────────────────────────
EXOTEL_ACCOUNT_SID=changeme
EXOTEL_API_KEY=changeme
EXOTEL_API_TOKEN=changeme
EXOTEL_CALLER_ID=changeme
# Shared secret Exotel has no native signing scheme for callbacks, so this
# is embedded as ?token=<secret> in both the dial-whom URL and the status
# callback URL (/api/provider/exotel/webhook) configured in the Exotel App
# Bazaar flow. The app sends no callback URL of its own.
# REQUIRED in production — the server refuses to start without it.
EXOTEL_WEBHOOK_SECRET=changeme
# Only used by the ad-hoc test.js smoke-test script
EXOTEL_TEST_FROM_NUMBER=+910000000000

# ── Meta WhatsApp Cloud API ──────────────────────────────────────────────
META_WHATSAPP_PHONE_NUMBER_ID=changeme
META_WHATSAPP_ACCESS_TOKEN=changeme
WHATSAPP_BUSINESS_ACCOUNT_ID=changeme
# Verification token you choose yourself for the Meta webhook handshake.
# No code-level default — if unset, webhook verification simply fails closed.
# REQUIRED in production — the server refuses to start without it.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=changeme
# Meta App Secret (Settings → Basic in the Meta App dashboard, NOT the
# WhatsApp access token) — verifies the X-Hub-Signature-256 header on every
# inbound webhook POST. Without it, the webhook accepts unsigned requests.
# REQUIRED in production — the server refuses to start without it.
META_APP_SECRET=changeme

# ── Email / SMTP ─────────────────────────────────────────────────────────
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=changeme
EMAIL_SMTP_PASS=changeme
EMAIL_FROM=noreply@parktag.me

# ── Google OAuth ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_CALLBACK_URL=http://127.0.0.1:4000/api/auth/google/callback

# ── Firebase (SMS sign-in on /owner-login) ────────────────────────────────
# Served to the browser by GET /api/auth/firebase-config; the server sends
# and checks the code (routes/auth/firebase.js). Unset → SMS sign-in is off.
# Firebase Web API keys are not secret by design (restrict via Firebase
# Console: API key restrictions + App Check), but still keep them in env
# vars rather than hardcoded so they can be rotated without a code change.
FIREBASE_API_KEY=changeme
FIREBASE_PROJECT_ID=changeme

# ── Razorpay ─────────────────────────────────────────────────────────────
# RAZORPAY_KEY_ID is safe to expose to the client (publishable key).
# RAZORPAY_KEY_SECRET must NEVER be sent to the client or logged.
# All three REQUIRED in production — the server refuses to start without them.
RAZORPAY_KEY_ID=changeme
RAZORPAY_KEY_SECRET=changeme
# Signs the webhook body (/api/provider/razorpay/webhook). A DIFFERENT secret
# from the key secret: set it against the webhook in the Razorpay dashboard.
# Without it the webhook refuses every callback, and a paid order whose buyer
# closed the tab is never fulfilled.
RAZORPAY_WEBHOOK_SECRET=changeme

# ── Google reCAPTCHA (optional) ──────────────────────────────────────────
# v3 (invisible score) on the OTP send. Both must be set; unset → no check.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
# v2 ("I'm not a robot" checkbox) on the tag-report form. A SEPARATE key pair:
# Google rejects a v3 key for the checkbox. Unset → no widget, no check.
RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET=

# ── Demo seed defense-in-depth (routes/system/demo.js) ────────────────────
# POST /api/demo/seed (non-production only) is disabled unless this is set,
# and every call must send it as {"secret": "..."}: the /verify page's Seed
# button asks for it. `npm run seed:demo` writes directly and needs none.
DEMO_SEED_SECRET=changeme

# ── Delhivery (physical sticker fulfilment) ───────────────────────────────
# Optional — pincode checks and shipment booking are skipped entirely
# (fail-open) if DELHIVERY_API_KEY or DELHIVERY_PICKUP_LOCATION are unset.
DELHIVERY_API_KEY=changeme
# Only override if you have a separate staging/sandbox account — defaults to
# Delhivery's staging URL outside production, production URL in production.
# Note: not all accounts have staging access; if yours doesn't, staging calls
# will 401 and you'll need to set this to https://track.delhivery.com even in dev.
DELHIVERY_BASE_URL=
# Must exactly match (case-sensitive) a pickup location/warehouse already
# registered in the Delhivery dashboard — this app does not create it for you.
DELHIVERY_PICKUP_LOCATION=changeme
DELHIVERY_SELLER_GST_TIN=
DELHIVERY_HSN_CODE=
# When the daily pickup rider should come, 24-hour with seconds. Defaults to
# 10:00:00, the start of the warehouse's registered pickup slot.
DELHIVERY_PICKUP_TIME=
# n8n webhook that posts the daily Amazon pickup result to Slack. Optional.
PICKUP_NOTIFY_WEBHOOK_URL=
# n8n webhook that posts each abandoned checkout (with the buyer's details) to
# Slack. Optional: unset turns the job off.
ABANDONED_NOTIFY_WEBHOOK_URL=

# ── Ola Maps (optional) ──────────────────────────────────────────────────
# Street suggestions, place names for a shared car location, the map image in
# the owner's alert and the COD address check. The key is domain-locked to
# parktag.me on Ola's side. Unset → each of those carries on without it.
OLA_MAPS_API_KEY=

# ── Scheduled WhatsApp campaigns (lib/core/scheduler.js) ──────────────────
# OFF unless set to 1: the scheduler messages real customers on a timer.
SCHEDULER_ENABLED=
# 1 → select and log recipients, send nothing. Run this before any new
# campaign's first live tick.
CAMPAIGN_DRY_RUN=
# 1 → the review request campaign runs. Set it only once Meta shows
# parktag_review_request_v1 as APPROVED and UTILITY.
REVIEW_REQUESTS_ENABLED=

# ── Manual verification scripts (src/backend/scripts/verify-*.js) ────────
WAVETAG_VERIFY_BASE_URL=http://127.0.0.1:3000
WAVETAG_VERIFY_TOKEN=changeme
WAVETAG_VERIFY_SCANNER_PHONE=+910000000000
WAVETAG_VERIFY_MESSAGE=Hi, your vehicle is blocking my way. Please move it when possible.
# verify-whatsapp-templates.js (npm run verify:whatsapp): the number that
# receives the test templates. Unset → it only checks template status.
WHATSAPP_TEST_TO=

# ── Landing traffic geography (admin → Traffic) ───────────────────────────
# Answers "where is our traffic coming from" from the visitor's IP, resolved
# server-side to a city and then discarded. No permission prompt, no cookie,
# and no IP or User-Agent is ever stored — see routes/system/analytics.js.
#
# REQUIRED to switch the feature on, and the SAME value must be set on the
# landing service too (landing/proxy.ts reads it). The landing site and this
# API are separate deployments, so the visitor's IP arrives in the request body
# rather than on the socket; this key is what makes that forwarded address
# trustworthy. Unset → every beacon is refused and the Traffic page stays empty.
ANALYTICS_INGEST_KEY=changeme
# Optional. Salt for the daily-rotating visitor digest; falls back to the
# ingest key above. Set it only if you'd rather the two not share a value.
ANALYTICS_HASH_SALT=
# Optional. Keys the hash that remembers a spent E-Tag free call after an
# account is deleted. Falls back to META_APP_SECRET.
FREE_CALL_HASH_KEY=
# Optional. The marketing site's own URL, so a link from our own pages is not
# counted as an inbound traffic source. e.g. https://parktag.me
LANDING_BASE_URL=
# Optional. IP→location provider: any URL containing {ip} that returns JSON
# with country / region / city. Defaults to ipwho.is, which needs no API key.
GEOIP_URL=

# Optional Slack operator commands. All four must be set; otherwise disabled.
# Signing secret from the EXISTING ParkTag logger Slack app, never a bot token.
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
SLACK_CHANNEL_ID=
SLACK_ADMIN_USER_IDS=

# Optional error monitoring. The DSN from Sentry project settings → Client Keys.
# Unset → nothing is sent. Events are stripped of request data, users and
# breadcrumbs, and phone numbers/emails are masked (lib/integrations/sentry.js).
SENTRY_DSN=

# ── Client-side analytics bundle (GET /pt-analytics.js) ───────────────────
# See docs/ANALYTICS_EVENTS.md. All three are optional and independent — any
# unset one simply installs a no-op for that vendor. Production only: leaving
# all three unset on staging/dev is what stops test traffic from being counted
# as real conversions and fed to Meta as an optimisation signal.
# GA4 property's Measurement ID (Admin → Data streams → your web stream).
GA4_MEASUREMENT_ID=
# Meta Pixel ID (Events Manager → your pixel → Settings). Never loaded on the
# public scan/report surface — see the privacy note in ANALYTICS_EVENTS.md.
META_PIXEL_ID=
# Microsoft Clarity project ID (clarity.microsoft.com → Settings → Setup).
CLARITY_PROJECT_ID=

# Optional. Mixpanel project token — owner-dashboard product analytics
# (sign-in, scans, calls, tag/membership management). Unset disables it.
MIXPANEL_TOKEN=

# Optional. Meta Conversions API (lib/integrations/meta-capi.js). Unlike the
# Pixel ID this IS a secret: a system-user token from Events Manager that can
# write events. Unset → no server-side events, the right state for dev.
META_CAPI_ACCESS_TOKEN=
# Optional. Set only while checking Events Manager → Test Events.
META_CAPI_TEST_EVENT_CODE=

# Optional. Our own public IPs (the office line), comma separated. Browsers on
# them get an analytics bundle that measures nothing, so internal testing stays
# out of GA4, the Meta Pixel and Clarity. A device anywhere can opt out too by
# opening any page once with ?pt_internal=1 (and back in with ?pt_internal=0).
INTERNAL_IPS=
# Optional. Our own mobile numbers, comma separated. Orders to one of these are
# marked internal and kept out of revenue (lib/core/internal-orders.js).
INTERNAL_TEST_PHONES=
