# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Anything prefixed NEXT_PUBLIC_ is bundled into client-side JS and visible to
# every visitor — only put values here that are safe to expose publicly.

# Public URL of the ParkTag owner/admin app, linked from the marketing site.
NEXT_PUBLIC_APP_URL=https://app.parktag.me
